{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Factor Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "getting-started/quickstart",
              "getting-started/understanding-review",
              "getting-started/how-factor-works"
            ]
          },
          {
            "group": "By Example",
            "pages": [
              "examples/example-reviews",
              "examples/financial",
              "examples/tax",
              "examples/authentication",
              "examples/background-jobs",
              "examples/api-contract",
              "examples/data-migration"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/verdicts",
              "reference/faq",
              "reference/security"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://usefactor.app",
          "icon": "arrow-up-right"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/usefactorhq"
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/wearefactor",
      "linkedin": "https://www.linkedin.com/company/wearefactor",
      "github": "https://github.com/usefactorhq"
    }
  },
  "icons": {
    "library": "lucide"
  }
}